{
  "name": "prism-structure-toolshop",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright (Prism) UI + API tests for Practice Software Testing Toolshop",
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep \"@smoke\"",
    "test:regression": "npx playwright test --grep \"@regression\" --pass-with-no-tests",
    "test:ui": "npx playwright test --project=ui",
    "test:api": "npx playwright test --project=api",
    "report": "npx playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
